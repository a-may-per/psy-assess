{
  "name": "psy-assess-demo",
  "version": "0.1.0",
  "private": true,
  "description": "psy-assess dual-person radar quiz demo",
  "scripts": {
    "dev:web": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build:web": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "tsc -p tsconfig.json --noEmit && node scripts/verifyLogic.mjs"
  },
  "dependencies": {
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "^4.3.0",
    "@tarojs/plugin-platform-weapp": "^4.3.0",
    "@tarojs/react": "^4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.27.1",
    "@tarojs/cli": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "babel-preset-taro": "^4.3.0",
    "typescript": "5.4.5",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
